      "id": "naturebench",
      "name": "NatureBench",
      "organization": "FrontisAI",
      "release_year": 2026,
      "summary": "A cross-disciplinary benchmark asking coding agents to solve scientific ML tasks distilled from Nature-family papers and compete with the papers' reported SOTA.",
      "classification": {
        "primary_dimension": "scientific-discovery",
        "secondary_dimensions": [
          "ai-r-and-d",
          "scientific-machine-learning"
