      "input": {
        "question_form": "Competition brief plus train/test data rather than a single natural-language question.",
        "agent_visible": [
          "/home/instructions.txt",
          "/home/data/description.md",
          "/home/data/*",
          "submission-format validator"
        ],
        "hidden": [
          "test labels",
          "competition grader",
          "test score during the run"
