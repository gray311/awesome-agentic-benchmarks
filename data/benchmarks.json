      },
      "urls": {
        "paper": "https://arxiv.org/abs/2410.07095",
        "repository": "https://github.com/openai/mle-bench",
        "leaderboard": "https://github.com/openai/mle-bench#leaderboard"
      },
      "task_suite": {
        "evaluation_units": 75,
        "development_units": 7,
        "lite_units": 22,
        "difficulty_split": {
          "low": 22,
          "medium": 38,
          "high": 15
        },
        "domains": [
          "machine-learning-engineering"
        ],
        "task_types": [
          "image-classification",
          "text-classification",
          "tabular-modeling",
          "image-segmentation",
          "audio-classification",
          "llm-training",
          "image-other",
          "forecasting",
