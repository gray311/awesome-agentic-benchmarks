        "leaderboard": "https://frontisai.github.io/NatureBench/"
      },
      "task_suite": {
        "evaluation_units": 90,
        "evaluated_instances": 332,
        "domains": [
          "cellular-omics",
          "protein-biology",
          "biomedical-modeling",
          "physical-modeling",
          "molecular-design",
          "relational-reasoning"
        ],
        "task_types": [
          "classification",
          "regression",
          "clustering-and-integration",
          "segmentation",
          "generation-and-design",
          "sequence-prediction",
          "structure-prediction",
          "forecasting",
          "combinatorial-optimization"
        ],
        "evaluation_unit_description": "One scientific ML problem distilled from a peer-reviewed Nature-family paper; a task may contain multiple evaluated instances."
      },
      "input": {
        "question_form": "A method-hidden scientific task brief, data description, and visible train/validation/test inputs.",
        "agent_visible": [
          "problem/README.md",
          "problem/data_description.md",
          "problem/data/*",
          "task-specific container environment"
        ],
        "hidden": [
          "source paper method pathway",
          "evaluation ground truth",
          "evaluation implementation directory"
        ],
        "feedback_during_run": "Limited score feedback through an external evaluation service; trajectories can contain multiple submission attempts."
      },
      "output": {
        "artifact": "workspace/run.py plus output/{instance_name}/predictions.csv",
