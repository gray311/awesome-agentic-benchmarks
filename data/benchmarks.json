        "executable": true
      },
      "evaluation": {
        "headline_metric": "Surpass-SOTA percentage",
        "headline_definition": "Percentage of all 90 tasks that are judge-valid and achieve SOTA-normalized relative gap g greater than 0.1.",
        "per_task_metrics": "Task-specific scientific metrics normalized as g = dir * (m - m_sota) / abs(m_sota).",
        "aggregation": "Task-level normalized gaps; current public scoring divides valid matches or surpasses by the full official task count.",
        "secondary_metrics": [
          "match-sota-percentage",
          "median-g-all",
          "median-g-valid",
          "completion-rate",
          "score-rate",
          "invalid-count"
        ],
        "judge_type": "deterministic per-task evaluator plus post-hoc LLM validity judge"
      },
      "environment": {
        "isolation": "independent task-specific Docker container with host-side evaluation service",
        "time_limit_hours": 4,
        "accelerator": "70 gpu_low tasks use 1x RTX 3090/4090 24GB; 17 gpu_high tasks use 1x NVIDIA A800 80GB; 3 tasks are CPU-only",
        "cpu": "task-dependent",
        "memory": "task-dependent",
        "dataset_scale": "approximately 1.25TB",
        "internet_policy": "Web search disabled for official comparable runs.",
        "scaffold_policy": "Built-in adapters support Claude Code, Codex, and Gemini CLI; custom agents are supported."
