{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gray311/awesome-agentic-benchmarks/blob/main/schema/discovery-task-sota.schema.json",
  "title": "Discovery task SOTA snapshot",
  "type": "object",
  "required": ["snapshot_date", "definition", "records"],
  "properties": {
    "$schema": {"type": "string"},
    "snapshot_date": {"type": "string", "format": "date"},
    "definition": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "status",
          "scope",
          "system",
          "score",
          "metric",
          "as_of",
          "evidence_status",
          "evidence_urls",
          "notes"
        ],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {
            "enum": [
              "live-leaderboard-best",
              "artifact-reported-best",
              "tie-at-published-precision",
              "precision-ambiguous",
              "source-reported-contract-incumbent",
              "suite-level-only"
            ]
          },
          "scope": {"enum": ["task-level", "contract-level", "suite-level"]},
          "system": {"type": ["string", "null"]},
          "score": {"type": ["number", "null"]},
          "metric": {
            "type": "object",
            "required": ["name", "direction", "unit"],
            "properties": {
              "name": {"type": "string"},
              "direction": {"enum": ["minimize", "maximize"]},
              "unit": {"type": "string"}
            },
            "additionalProperties": false
          },
          "as_of": {"type": "string", "format": "date"},
          "evidence_status": {"type": "string"},
          "source_reported": {
            "type": "object",
            "required": ["system", "score", "evidence_urls"],
            "properties": {
              "system": {"type": "string", "minLength": 1},
              "score": {"type": "number"},
              "evidence_urls": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "format": "uri"}
              }
            },
            "additionalProperties": false
          },
          "candidates": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["system", "score"],
              "properties": {
                "system": {"type": "string", "minLength": 1},
                "score": {"type": "number"}
              },
              "additionalProperties": false
            }
          },
          "suite_best": {
            "type": "object",
            "required": ["system", "score", "metric_name", "unit"]
          },
          "human_reference": {"type": "string"},
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "format": "uri"}
          },
          "notes": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
