{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/awesome-agentic-benchmarks/discovery-task.schema.json",
  "title": "Discovery Task Registry",
  "type": "object",
  "required": ["registry_version", "last_updated", "source_suites", "tasks"],
  "properties": {
    "$schema": {"type": "string"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "last_updated": {"type": "string", "format": "date"},
    "source_suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "evaluated_model", "result_status", "paper", "repository", "task_catalogue", "task_contract"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string"},
          "role": {"enum": ["task-source", "task-source-and-evaluated-system"]},
          "evaluated_model": {"type": "string"},
          "result_status": {"enum": ["source-reported", "independently-reproduced", "independently-certified"]},
          "paper": {"type": "string", "format": "uri"},
          "repository": {"type": "string", "format": "uri"},
          "task_catalogue": {"type": "string", "format": "uri"},
          "task_contract": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id", "name", "domain", "source_suite", "question", "input", "output",
        "metric", "evaluation", "environment", "reference_result", "reported_result",
        "outcome", "evidence_urls", "integrity_notes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 3},
        "domain": {
          "enum": [
            "quantum-compilation", "astrodynamics", "scientific-algorithms",
            "ai-foundations", "mathematics-discovery"
          ]
        },
        "source_suite": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "question": {"type": "string", "minLength": 10},
        "input": {"type": "string", "minLength": 10},
        "output": {"type": "string", "minLength": 3},
        "metric": {
          "type": "object",
          "required": ["name", "direction", "unit"],
          "properties": {
            "name": {"type": "string"},
            "direction": {"enum": ["minimize", "maximize"]},
            "unit": {"type": "string"}
          },
          "additionalProperties": false
        },
        "evaluation": {"type": "string", "minLength": 10},
        "environment": {"type": "string", "minLength": 3},
        "reference_result": {"$ref": "#/$defs/result"},
        "reported_result": {"$ref": "#/$defs/result"},
        "outcome": {"enum": ["improved", "matched-reference", "below-reference"]},
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "format": "uri"},
          "uniqueItems": true
        },
        "integrity_notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["system", "score"],
      "properties": {
        "system": {"type": "string"},
        "score": {"type": "number"}
      },
      "additionalProperties": false
    }
  }
}
