{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/awesome-agentic-benchmarks/benchmark-metadata.schema.json",
  "title": "Benchmark Launch and GitHub Metadata",
  "type": "object",
  "required": ["registry_version", "last_updated", "star_snapshot_as_of", "policy", "benchmarks"],
  "properties": {
    "$schema": {"type": "string"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "last_updated": {"type": "string", "format": "date"},
    "star_snapshot_as_of": {"type": "string", "format": "date"},
    "policy": {
      "type": "object",
      "required": ["launch", "stars"],
      "properties": {"launch": {"type": "string"}, "stars": {"type": "string"}},
      "additionalProperties": false
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/benchmark"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "benchmark": {
      "type": "object",
      "required": ["id", "name", "launch", "github"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 2},
        "launch": {
          "type": "object",
          "required": ["value", "precision", "basis", "source"],
          "properties": {
            "value": {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"},
            "precision": {"enum": ["year", "month", "day"]},
            "basis": {"enum": ["paper", "official-release", "dataset-publication", "project-launch", "repository-publication"]},
            "source": {"type": "string", "format": "uri"}
          },
          "additionalProperties": false
        },
        "github": {
          "type": "object",
          "required": ["repository", "repository_scope", "stars", "stars_as_of", "status"],
          "properties": {
            "repository": {"type": ["string", "null"], "pattern": "^[^/]+/[^/]+$"},
            "repository_scope": {"enum": ["benchmark-specific", "shared-suite", "toolkit", "none"]},
            "stars": {"type": ["integer", "null"], "minimum": 0},
            "stars_as_of": {"type": ["string", "null"], "format": "date"},
            "status": {"enum": ["available", "repository-unavailable", "no-official-repository"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
